This is a personal setup but feel free to fork, adapt, and PR improvements.
README_EOF

    # install.sh
    cat > install.sh << 'INSTALL_EOF'
#!/usr/bin/env bash
set -e
echo "🚀 Vivaldi Cockpit installer"
mkdir -p ~/.local/bin ~/.config/vivaldi/User ~/.vivaldi-dashboard ~/.config/systemd/user
cp scripts/* ~/.local/bin/
chmod +x ~/.local/bin/vc*
cp vivaldi/User/custom.css ~/.config/vivaldi/User/
cp -r vivaldi/dashboard/* ~/.vivaldi-dashboard/
cp systemd/* ~/.config/systemd/user/
[ -f bash/vc-aliases.sh ] && cp bash/vc-aliases.sh ~/.config/
[ -f fish/vc.fish ] && mkdir -p ~/.config/fish/conf.d && cp fish/vc.fish ~/.config/fish/conf.d/
echo "✓ Files copied"

# Python venv
if [ ! -d ~/.local/venvs/vc ]; then
  python3 -m venv ~/.local/venvs/vc
  ~/.local/venvs/vc/bin/pip install rich requests weasyprint markdown reportlab
fi
echo "✓ Python venv"

# Enable systemd timer
systemctl --user daemon-reload
systemctl --user enable --now vivaldi-health.timer 2>/dev/null || true
echo "✓ systemd timer enabled"

# Add to shell
if [ -f ~/.bashrc ] && ! grep -q vc-aliases ~/.bashrc; then
  echo '[ -f ~/.config/vc-aliases.sh ] && source ~/.config/vc-aliases.sh' >> ~/.bashrc
fi

echo ""
echo "✅ Installed! Open a new terminal and type 'v' to begin."
echo "📖 Read docs/vivaldi-tam-bele.md for full guide."
INSTALL_EOF
    chmod +x install.sh

    # .gitignore
    cat > .gitignore << 'GIT_EOF'
*.pyc
__pycache__/
*.bak
*.log
.cache/
GIT_EOF

    # LICENSE
    cat > LICENSE << 'LIC_EOF'
MIT License

Copyright (c) 2026 Adil (DarkTLord)

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
LIC_EOF

    # Strip secrets from copied configs (extra safety)
    grep -rl "academytural\|reg_b911\|ANTHROPIC_API_KEY\|github_pat" "$REPO_DIR" 2>/dev/null | while read f; do
      sed -i 's/academytural@gmail\.com/your-email@example.com/g; s/reg_b911[a-f0-9]*/REDACTED_TOKEN/g' "$f" 2>/dev/null || true
    done

    echo "✓ Repository struktur hazırdır: $REPO_DIR"
    echo ""
    ls -la "$REPO_DIR"
    ;;

  push)
    [ ! -d "$REPO_DIR/.git" ] && { echo "❌ Əvvəlcə: vc-share init"; exit 1; }
    cd "$REPO_DIR"
    git add -A
    git -c user.name='Adil' -c user.email='academytural@gmail.com' commit -m "Initial commit: Vivaldi Cockpit 2026 setup" || true

    # Repo varsa skip yaratmağı
    if ! gh repo view "$GH_USER/$REPO_NAME" >/dev/null 2>&1; then
      gh repo create "$GH_USER/$REPO_NAME" --public --source=. --description "$DESCRIPTION" --push
      echo "✓ Repo yaradıldı və push olundu"
    else
      git remote get-url origin >/dev/null 2>&1 || git remote add origin "https://github.com/$GH_USER/$REPO_NAME.git"
      git branch -M main
      git push -u origin main
      echo "✓ Push olundu"
    fi
    echo ""
    echo "🌐 https://github.com/$GH_USER/$REPO_NAME"
    ;;

  open)
    xdg-open "https://github.com/$GH_USER/$REPO_NAME" 2>/dev/null || \
      vivaldi "https://github.com/$GH_USER/$REPO_NAME" &>/dev/null & disown
    ;;

  status)
    if [ -d "$REPO_DIR/.git" ]; then
      cd "$REPO_DIR"
      echo "📂 Yerli: $REPO_DIR"
      echo ""
      git status -s
      echo ""
      git log --oneline -5 2>/dev/null
    else
      echo "❌ Repo hələ initialize olunmayıb"
      echo "→ vc-share init"
    fi
    ;;

  help|*)
    cat << 'EOF'
🌐 vc-share — Setup-ı GitHub-da paylaş

ƏMRLƏR:
  init      Repo struktur yarat (~/vivaldi-cockpit-dotfiles)
  push      GitHub-a push et (gh CLI ilə avtomatik)
  open      GitHub-da açır
  status    Yerli repo vəziyyəti

İŞ AXINI:
  vc-share init    # 1. Yerli repo yarat
  vc-share push    # 2. GitHub-a göndər
  vc-share open    # 3. Browser-də gör
EOF
    ;;
esac
