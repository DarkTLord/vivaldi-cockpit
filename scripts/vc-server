@app.get("/", response_class=HTMLResponse)
def index(): return INDEX_HTML

@app.websocket("/ws/metrics")
async def ws_metrics(ws: WebSocket):
    await ws.accept()
    try:
        while True:
            await ws.send_json(get_metrics())
            await asyncio.sleep(2)
    except WebSocketDisconnect: pass

def get_metrics():
    out = subprocess.run(["pgrep", "-f", "/opt/vivaldi/vivaldi-bin"], capture_output=True, text=True)
    procs = len(out.stdout.strip().splitlines()) if out.stdout.strip() else 0
    ram = 0
    if procs:
        ps = subprocess.run(["ps", "-eo", "rss,comm"], capture_output=True, text=True).stdout
        ram = sum(int(l.split()[0]) for l in ps.splitlines()[1:] if "vivaldi" in l) / 1024
    try:
        with open("/proc/meminfo") as f:
            mi = {l.split(":")[0]: int(l.split()[1]) for l in f if ":" in l}
        sys_total = mi.get("MemTotal", 1) / 1024 / 1024
        sys_used = sys_total - mi.get("MemAvailable", 0) / 1024 / 1024
    except Exception: sys_total, sys_used = 1, 0
    bm_path = HOME / ".config/vivaldi/Default/Bookmarks"
    try:
        d = json.loads(bm_path.read_text())
        urls = [0]
        def walk(n):
            if n.get("type") == "url": urls[0] += 1
            for c in n.get("children", []): walk(c)
        for r in d.get("roots", {}).values(): walk(r)
        bm = urls[0]
    except Exception: bm = 0
    try:
        disk = int(subprocess.check_output(["du", "-sb", str(HOME / ".config/vivaldi")]).split()[0]) / 1024 / 1024
    except Exception: disk = 0
    return {
        "status": "✅ Aktiv" if procs else "❌ Qapalı",
        "ram_mb": ram, "sys_ram_used": sys_used, "sys_ram_total": sys_total,
        "procs": procs, "bookmarks": bm, "disk_mb": disk,
        "time": datetime.now().strftime("%H:%M:%S")
    }

@app.get("/api/search")
def search_api(q: str = ""):
    if not q: return {"results": []}
    bm_path = HOME / ".config/vivaldi/Default/Bookmarks"
    results = []
    try:
        d = json.loads(bm_path.read_text())
        ql = q.lower()
        def walk(n):
            if n.get("type") == "url":
                if ql in (n.get("name","")+" "+n.get("url","")).lower():
                    results.append({"source":"📑 BM","name":n.get("name",""),"url":n.get("url","")})
            for c in n.get("children", []): walk(c)
        for r in d.get("roots", {}).values(): walk(r)
    except Exception: pass
    return {"results": results[:15]}

@app.get("/api/cmd/{action}")
def cmd_api(action: str):
    valid = {"ai","aiquintet","localhost","dash","start","kill","weekly","health","ext","backup"}
    if action.split()[0] in valid:
        try:
            subprocess.Popen(["vc"] + action.split())
            return {"message": f"✓ vc {action} icra olundu"}
        except Exception as e: return {"message": f"❌ {e}"}
    return {"message": "❌ Bilinməyən komanda"}

@app.get("/api/ask")
def ask_api(q: str):
    try:
        import requests
        r = requests.post("http://localhost:11434/api/generate",
            json={"model":"mistral:7b","prompt":q,"stream":False,
                  "options":{"num_predict":500,"temperature":0.7}}, timeout=60)
        return {"answer": r.json().get("response", "(boş cavab)")}
    except Exception as e: return {"answer": f"❌ Ollama: {e}"}

@app.get("/api/focus")
def focus_api(duration: int = 25, mode: str = "work"):
    try:
        subprocess.Popen(["vc-focus", str(duration), mode])
        emoji = "🍅" if mode == "work" else "☕"
        return {"message": f"{emoji} {mode} {duration} dəq başladı"}
    except Exception as e: return {"message": f"❌ {e}"}

@app.get("/api/snap/save")
def snap_save(name: str):
    try:
        out = subprocess.run(["vc-snap", "save", name], capture_output=True, text=True, timeout=10)
        return {"message": out.stdout.strip() or "💾 saxlanıldı"}
    except Exception as e: return {"message": f"❌ {e}"}

@app.get("/api/snap/list")
def snap_list_api():
    snap_dir = HOME / ".config/vivaldi-snapshots"
    if not snap_dir.exists(): return {"snapshots": []}
    snaps = []
    for f in sorted(snap_dir.glob("*.json")):
        if "-bookmarks" in f.name or "-tabs" in f.name: continue
        try:
            d = json.loads(f.read_text())
            snaps.append({"name": d.get("name", f.stem), "tabs": len(d.get("tabs", [])),
                          "created": d.get("created", "")[:16]})
        except Exception: pass
    return {"snapshots": snaps}

@app.get("/api/snap/load")
def snap_load_api(name: str):
    try:
        out = subprocess.run(["vc-snap", "load", name], capture_output=True, text=True, timeout=15)
        return {"message": out.stdout.strip() or f"✓ {name} bərpa olundu"}
    except Exception as e: return {"message": f"❌ {e}"}

@app.get("/api/brief")
def brief_api():
    try:
        out = subprocess.run(["vc-brief"], capture_output=True, text=True, timeout=120)
        return {"brief": out.stdout or out.stderr or "❌ Brief boş"}
    except Exception as e: return {"brief": f"❌ {e}"}

@app.get("/api/bm/count")
def bm_count():
    bm_path = HOME / ".config/vivaldi/Default/Bookmarks"
    try:
        d = json.loads(bm_path.read_text())
        urls, folders = [0], [0]
        def walk(n):
            if n.get("type") == "url": urls[0] += 1
            elif n.get("type") == "folder": folders[0] += 1
            for c in n.get("children", []): walk(c)
        for r in d.get("roots", {}).values(): walk(r)
        return {"urls": urls[0], "folders": folders[0]}
    except Exception as e: return {"urls": 0, "folders": 0}

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "start"
    if cmd in ("start", "run"):
        print(f"🚀 Vivaldi Cockpit: http://{HOST}:{PORT}")
        uvicorn.run(app, host=HOST, port=PORT, log_level="warning")
    elif cmd in ("status", "st"):
        try:
            import requests
            r = requests.get(f"http://{HOST}:{PORT}/api/bm/count", timeout=2)
            print(f"✓ Server aktiv: http://{HOST}:{PORT} · BM: {r.json()}")
        except Exception:
            print("❌ Server qapalıdır")
    elif cmd == "open":
        subprocess.Popen(["vivaldi", f"http://{HOST}:{PORT}"])
    else:
        print(f"vc-server start | status | open")

if __name__ == "__main__":
    main()
