<script>
const $=id=>document.getElementById(id);
function clear(el){while(el.firstChild)el.removeChild(el.firstChild);}
function mkEl(tag,opts={}){const e=document.createElement(tag);if(opts.cls)e.className=opts.cls;if(opts.text)e.textContent=opts.text;if(opts.html_safe)e.textContent=opts.html_safe;return e;}

async function api(path){const r=await fetch(path);return r.headers.get('content-type')?.includes('json')?r.json():r.text();}

const ws=new WebSocket(`ws://${location.host}/ws/metrics`);
ws.onmessage=e=>{
  const d=JSON.parse(e.data);
  const c=$('metrics');clear(c);
  const items=[
    ['Status',d.status],
    ['Vivaldi RAM',d.ram_mb.toFixed(0)+' MB'],
    ['Sistem RAM',d.sys_ram_used.toFixed(1)+'/'+d.sys_ram_total.toFixed(1)+' GB',d.sys_ram_used/d.sys_ram_total*100],
    ['Proseslər',String(d.procs)],
    ['Bookmark',String(d.bookmarks)],
    ['Disk',d.disk_mb.toFixed(0)+' MB'],
    ['Vaxt',d.time]
  ];
  for(const [label,val,bar] of items){
    const m=mkEl('div',{cls:'metric'});
    m.appendChild(mkEl('span',{cls:'label',text:label}));
    const v=mkEl('div');
    v.appendChild(mkEl('span',{cls:'value',text:val}));
    if(bar!=null){
      const b=mkEl('div',{cls:'bar'});
      const f=mkEl('div',{cls:'bar-fill'});
      f.style.width=bar+'%';b.appendChild(f);v.appendChild(b);
    }
    m.appendChild(v);c.appendChild(m);
  }
};

let searchTimer;
function search(){
  clearTimeout(searchTimer);
  const q=$('searchInput').value.trim();
  if(!q){clear($('searchResults'));return;}
  searchTimer=setTimeout(async()=>{
    const r=await api('/api/search?q='+encodeURIComponent(q));
    const sr=$('searchResults');clear(sr);
    if(!r.results.length){sr.appendChild(mkEl('div',{text:'Heç bir nəticə'}));return;}
    for(const x of r.results){
      const item=mkEl('div',{cls:'result-item'});
      const tag=mkEl('span',{cls:'tag',text:x.source});
      const title=mkEl('span',{cls:'title',text:x.name});
      const url=mkEl('div',{cls:'url',text:x.url||x.preview||''});
      item.appendChild(tag);item.appendChild(title);item.appendChild(url);
      item.onclick=()=>window.open(x.url,'_blank');
      sr.appendChild(item);
    }
  },300);
}

async function cmd(c){const r=await api('/api/cmd/'+c);alert(r.message);}

